#!/bin/bash

config=/etc/lxcdockercomposeupdate.conf
cancel=0
plan=0

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: lxcdockercomposeupdate [--plan] [--config FILE] [LXC_ID ...]\n'
}

while (( $# )); do
    case $1 in
        --help|-h) usage; exit 0 ;;
        --plan) plan=1; shift ;;
        --config)
            (( $# >= 2 )) || die 'Missing configuration file path.'
            config=$2
            [[ -r $config ]] || die "Cannot read $config."
            shift 2 ;;
        --) shift; break ;;
        -*) die "Unknown option: $1" ;;
        *) break ;;
    esac
done

declare -a project_ids=() directories=() settings=() configured=() selected=() excluded=() summary=()
contains_id() {
    local needle=$1 candidate
    shift
    for candidate in "$@"; do
        [[ $candidate == "$needle" ]] && return 0
    done
    return 1
}

compose_options() {
    local fields=$1 setting key value
    options=()
    while [[ -n $fields ]]; do
        setting=${fields%%$'\t'*}
        if [[ $fields == *$'\t'* ]]; then
            fields=${fields#*$'\t'}
        else
            fields=
        fi
        key=${setting%%=*}
        value=${setting#*=}
        [[ $setting == *=* && -n $value ]] || return 1
        case $key in
            env-file|profile|project-name|file) options+=("--$key" "$value") ;;
            *) return 1 ;;
        esac
    done
}

if [[ -e $config ]]; then
    [[ -r $config ]] || die "Cannot read $config."
    line=0
    while read -r id directory || [[ -n $id ]]; do
        (( line += 1 ))
        [[ -z $id || $id == \#* ]] && continue
        if [[ $id == exclude ]]; then
            [[ $directory =~ ^[1-9][0-9]*$ ]] || die "$config:$line: expected exclude followed by an LXC ID."
            excluded+=("$directory")
            continue
        fi
        fields=
        if [[ $directory == *$'\t'* ]]; then
            fields=${directory#*$'\t'}
            directory=${directory%%$'\t'*}
        fi
        compose_options "$fields" || die "$config:$line: invalid Compose setting."
        [[ $id =~ ^[1-9][0-9]*$ && $directory == /* ]] ||
            die "$config:$line: expected an LXC ID followed by an absolute guest directory."
        project_ids+=("$id")
        directories+=("$directory")
        settings+=("$fields")
        if ! contains_id "$id" "${configured[@]}"; then
            configured+=("$id")
        fi
    done < "$config"
fi

(( EUID == 0 )) || die 'Run this as root on the Proxmox host.'
command -v pct >/dev/null || die 'Required command missing: pct'
if (( ! plan )); then
    for tool in flock timeout; do
        command -v "$tool" >/dev/null || die "Required command missing: $tool"
    done
    exec 9>>/run/lock/proxmox-lxc-updater.lock || die 'Could not open the updater lock.'
    flock -n 9 || die 'Could not acquire the updater lock. Another run may be active.'
fi

inventory=$(pct list) || die 'Could not list local LXCs.'
declare -a local_ids=()
while read -r id _; do
    [[ $id =~ ^[1-9][0-9]*$ ]] && local_ids+=("$id")
done <<< "$inventory"
explicit=$#
for id in "$@"; do
    contains_id "$id" "${local_ids[@]}" || die "LXC $id is not on this node."
    contains_id "$id" "${selected[@]}" || selected+=("$id")
done
if (( ${#selected[@]} == 0 )); then
    selected=("${local_ids[@]}")
fi
if (( ${#selected[@]} == 0 )); then
    printf 'No local LXCs found.\n'
    exit 0
fi

trap 'cancel=130' INT
trap 'cancel=143' TERM
trap 'cancel=129' HUP

wait_for_docker() {
    local id=$1 deadline=$((SECONDS + 60)) remaining probe
    while (( cancel == 0 && SECONDS < deadline )); do
        remaining=$((deadline - SECONDS))
        (( remaining <= 5 )) || remaining=5
        if probe=$(timeout -k 1 "$remaining" pct exec "$id" -- sh -c '
            if command -v docker >/dev/null 2>&1; then
                docker info >/dev/null
            else
                printf "no-docker"
            fi' </dev/null 2>/dev/null); then
            [[ $probe != no-docker ]] || return 2
            return 0
        fi
        (( cancel == 0 && SECONDS < deadline )) && sleep 1
    done
    (( cancel == 0 )) || return 0
    printf 'LXC %s: Docker did not become ready within 60 seconds.\n' "$id" >&2
    return 1
}

update_project() {
    local id=$1 directory=$2
    shift 2
    printf 'LXC %s updating %s\n' "$id" "$directory"
    pct exec "$id" -- sh -c 'cd "$1" && shift && exec docker compose "$@"' \
        lxcdockercomposeupdate "$directory" "$@" pull </dev/null || return 1
    (( cancel == 0 )) || return 0
    pct exec "$id" -- sh -c 'cd "$1" && shift && exec docker compose "$@"' \
        lxcdockercomposeupdate "$directory" "$@" up -d </dev/null
}

update_projects() {
    local id=$1 index readiness records project directory files file
    local -a handled=() compose_args=() compose_files=() options=()
    wait_for_docker "$id"
    readiness=$?
    if (( readiness == 2 )) && ! contains_id "$id" "${configured[@]}"; then
        return 2
    fi
    (( readiness == 0 )) || return 1
    (( cancel == 0 )) || return 0

    if contains_id "$id" "${configured[@]}"; then
        for index in "${!project_ids[@]}"; do
            (( cancel == 0 )) || break
            [[ ${project_ids[index]} == "$id" ]] || continue
            compose_options "${settings[index]}"
            update_project "$id" "${directories[index]}" "${options[@]}" || return 1
        done
        return 0
    fi

    records=$(pct exec "$id" -- docker ps -a \
        --filter label=com.docker.compose.project \
        --format '{{.Label "com.docker.compose.project"}}{{printf "\x1f"}}{{.Label "com.docker.compose.project.working_dir"}}{{printf "\x1f"}}{{.Label "com.docker.compose.project.config_files"}}' </dev/null) ||
        return 1
    if [[ -z $records ]]; then
        return 3
    fi
    while IFS=$'\x1f' read -r project directory files; do
        (( cancel == 0 )) || break
        contains_id "$project" "${handled[@]}" && continue
        if [[ -z $project || $directory != /* || -z $files ]]; then
            printf 'LXC %s: incomplete Compose labels for project %s. Set its guest directory in the config.\n' "$id" "$project" >&2
            return 1
        fi
        handled+=("$project")
        compose_args=(-p "$project")
        IFS=, read -r -a compose_files <<< "$files"
        for file in "${compose_files[@]}"; do
            compose_args+=(-f "$file")
        done
        update_project "$id" "$directory" "${compose_args[@]}" || return 1
    done <<< "$records"
    return 0
}

failed=0
for id in "${selected[@]}"; do
    (( cancel == 0 )) || break
    if (( explicit == 0 )) && contains_id "$id" "${excluded[@]}"; then
        summary+=("LXC $id: skipped (excluded)")
        continue
    fi
    if ! guest_config=$(pct config "$id"); then
        summary+=("LXC $id: failed to read guest configuration")
        failed=1
        continue
    fi
    if [[ $guest_config =~ (^|$'\n')template:[[:blank:]]+1($|$'\n') ]]; then
        summary+=("LXC $id: skipped (template)")
        continue
    fi
    if ! state=$(pct status "$id"); then
        summary+=("LXC $id: failed to read power state")
        failed=1
        continue
    fi
    case "$state" in
        'status: running'|'status: stopped') ;;
        *)
            summary+=("LXC $id: unexpected power state ($state)")
            failed=1
            continue ;;
    esac
    (( cancel == 0 )) || break
    if (( plan )); then
        if [[ $state == 'status: stopped' ]]; then
            summary+=("LXC $id: would start, check for Compose projects, then shut down")
        else
            summary+=("LXC $id: would check for Compose projects and leave running")
        fi
        for index in "${!project_ids[@]}"; do
            [[ ${project_ids[index]} != "$id" ]] || summary+=("  Configured: ${directories[index]}")
        done
        continue
    fi
    printf 'LXC %s was %s\n' "$id" "${state#status: }"
    if [[ $state == 'status: stopped' ]] && ! pct start "$id"; then
        summary+=("LXC $id: start failed")
        failed=1
        continue
    fi

    outcome=interrupted
    if (( cancel == 0 )); then
        update_projects "$id"
        case $? in
            0) outcome=updated ;;
            2) outcome='skipped (Docker unavailable)' ;;
            3) outcome='skipped (no deployed Compose projects)' ;;
            *) outcome='update failed'; failed=1 ;;
        esac
        (( cancel == 0 )) || outcome=interrupted
    fi
    if [[ $state == 'status: stopped' ]]; then
        restoration='stopped state restored'
        if [[ $(pct status "$id") != 'status: stopped' ]]; then
            printf 'LXC %s shutting down\n' "$id"
            if ! pct shutdown "$id" --timeout 60 || [[ $(pct status "$id") != 'status: stopped' ]]; then
                restoration='shutdown failed; check power state'
                failed=1
            fi
        fi
        outcome="$outcome ($restoration)"
    fi
    summary+=("LXC $id: $outcome")
done
if (( plan )); then
    printf '\nPlan (no guests started or changed)\n'
else
    printf '\nRun summary\n'
fi
if (( ${#summary[@]} )); then
    printf '%s\n' "${summary[@]}"
fi
(( cancel == 0 )) || exit "$cancel"
exit "$failed"
