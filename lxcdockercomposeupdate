#!/bin/bash

config=/etc/lxcdockercomposeupdate.conf
cancel=0

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: lxcdockercomposeupdate [--config FILE] [LXC_ID ...]\n'
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    usage
    exit 0
fi
if [[ ${1:-} == --config ]]; then
    (( $# >= 2 )) || die 'Missing configuration file path.'
    config=$2
    shift 2
fi

[[ -r $config ]] || die "Cannot read $config."
declare -a project_ids=() directories=() configured=() selected=()
contains_id() {
    local needle=$1 candidate
    shift
    for candidate in "$@"; do
        [[ $candidate == "$needle" ]] && return 0
    done
    return 1
}

line=0
while read -r id directory || [[ -n $id ]]; do
    (( line += 1 ))
    [[ -z $id || $id == \#* ]] && continue
    [[ $id =~ ^[1-9][0-9]*$ && $directory == /* ]] ||
        die "$config:$line: expected an LXC ID followed by an absolute guest directory."
    project_ids+=("$id")
    directories+=("$directory")
    if ! contains_id "$id" "${configured[@]}"; then
        configured+=("$id")
    fi
done < "$config"
(( ${#configured[@]} )) || die "No LXC projects configured in $config."

for id in "$@"; do
    contains_id "$id" "${configured[@]}" || die "Unconfigured LXC ID: $id"
    if ! contains_id "$id" "${selected[@]}"; then
        selected+=("$id")
    fi
done
if (( ${#selected[@]} == 0 )); then
    selected=("${configured[@]}")
fi

(( EUID == 0 )) || die 'Run this as root on the Proxmox host.'
for tool in pct flock timeout; do
    command -v "$tool" >/dev/null || die "Required command missing: $tool"
done
exec 9>/run/lock/proxmox-lxc-updater.lock || die 'Could not open the updater lock.'
flock -n 9 || die 'Could not acquire the updater lock. Another run may be active.'

trap 'cancel=130' INT
trap 'cancel=143' TERM
trap 'cancel=129' HUP

wait_for_docker() {
    local id=$1 deadline=$((SECONDS + 60)) remaining
    while (( cancel == 0 && SECONDS < deadline )); do
        remaining=$((deadline - SECONDS))
        (( remaining <= 5 )) || remaining=5
        if timeout -k 1 "$remaining" pct exec "$id" -- docker info </dev/null >/dev/null 2>&1; then
            return 0
        fi
        (( cancel == 0 && SECONDS < deadline )) && sleep 1
    done
    (( cancel == 0 )) || return 0
    printf 'LXC %s: Docker did not become ready within 60 seconds.\n' "$id" >&2
    return 1
}

update_projects() {
    local id=$1 index action
    wait_for_docker "$id" || return 1
    for index in "${!project_ids[@]}"; do
        (( cancel == 0 )) || break
        [[ ${project_ids[index]} == "$id" ]] || continue
        printf 'LXC %s updating %s\n' "$id" "${directories[index]}"
        for action in pull up; do
            (( cancel == 0 )) || break
            local -a compose_args=("$action")
            [[ $action != up ]] || compose_args+=(-d)
            pct exec "$id" -- sh -c 'cd "$1" && shift && exec docker compose "$@"' \
                lxcdockercomposeupdate "${directories[index]}" "${compose_args[@]}" </dev/null ||
                return 1
        done
    done
    return 0
}

failed=0
for id in "${selected[@]}"; do
    (( cancel == 0 )) || break
    if ! state=$(pct status "$id"); then
        printf 'LXC %s: could not read power state.\n' "$id" >&2
        failed=1
        continue
    fi
    case "$state" in
        'status: running'|'status: stopped') ;;
        *)
            printf 'LXC %s: unexpected power state: %s\n' "$id" "$state" >&2
            failed=1
            continue ;;
    esac
    (( cancel == 0 )) || break
    printf 'LXC %s was %s\n' "$id" "${state#status: }"
    if [[ $state == 'status: stopped' ]] && ! pct start "$id"; then
        printf 'LXC %s: start failed.\n' "$id" >&2
        failed=1
        continue
    fi

    if (( cancel == 0 )) && ! update_projects "$id"; then
        printf 'LXC %s: update failed.\n' "$id" >&2
        failed=1
    fi
    if [[ $state == 'status: stopped' ]]; then
        if [[ $(pct status "$id") != 'status: stopped' ]]; then
            printf 'LXC %s shutting down\n' "$id"
            if ! pct shutdown "$id" --timeout 60 || [[ $(pct status "$id") != 'status: stopped' ]]; then
                printf 'LXC %s: could not restore the stopped state.\n' "$id" >&2
                failed=1
            fi
        fi
    fi
done
(( cancel == 0 )) || exit "$cancel"
exit "$failed"
