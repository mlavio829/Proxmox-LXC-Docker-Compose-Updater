#!/bin/bash
# lxcdockercomposeupdater self-update format 1

config=/etc/lxcdockercomposeupdater.conf
cancel=0
plan=0
prune=0

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

get_latest() (
    (( EUID == 0 )) || die 'Run -getlatest as root on the Proxmox host.'
    local target=/usr/local/bin/lxcdockercomposeupdater tmp
    local repo=mlavio829/ProxmoxLXCUpdater revision url
    revision=$(wget -qO- --no-cache --header='Accept: application/vnd.github.sha' \
        "https://api.github.com/repos/$repo/commits/main") ||
        die 'Could not resolve the latest version on GitHub.'
    [[ $revision =~ ^[0-9a-f]{40}$ ]] || die 'GitHub did not return a valid commit ID.'
    url="https://raw.githubusercontent.com/$repo/$revision/lxcdockercomposeupdater"
    tmp=$(mktemp /usr/local/bin/.lxcdockercomposeupdater.XXXXXX) || die 'Could not stage the update.'
    trap 'rm -f -- "$tmp"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    wget -O "$tmp" "$url" || die 'Could not download the latest version.'
    local header format
    {
        read -r header && read -r format &&
            [[ $header == '#!/bin/bash' && $format == '# lxcdockercomposeupdater self-update format 1' ]]
    } < "$tmp" && bash -n "$tmp" ||
        die 'The download is invalid or predates the lxcdockercomposeupdater command.'
    if [[ -x $target ]] && cmp -s "$tmp" "$target"; then
        printf 'lxcdockercomposeupdater is already up to date (%s).\n' "${revision:0:7}"
    else
        chmod 0755 "$tmp" && mv -fT -- "$tmp" "$target" || die 'Could not install the update.'
        printf 'Updated %s to %s\n' "$target" "${revision:0:7}"
    fi
)

write_config_guide() {
    cat <<'CONFIG'
# lxcdockercomposeupdater configuration guide
#
# Save this file as /etc/lxcdockercomposeupdater.conf. Blank lines and lines
# beginning with # are ignored. To activate an example, remove its leading
# "# " and replace the sample LXC ID and paths with your own. Leave comments
# on separate lines. You can leave this whole file commented out to use
# automatic Compose discovery across all eligible LXCs on this Proxmox node.
#
# EXCLUDE GUESTS FROM BULK RUNS
# Syntax: exclude LXC_ID
# Use one line per guest. This applies to bulk updates and pruning.
# Passing the ID explicitly overrides the exclusion for that run.
#
# exclude 100
# exclude 310
#
# SET COMPOSE PROJECT DIRECTORIES MANUALLY
# Syntax: LXC_ID /absolute/path/inside/the/guest
# Use one line per project. Spaces in directory names are allowed. Do not
# put quotes around paths. Each directory should contain a Compose file,
# unless you supply file= below.
# For an LXC with manual entries, list ALL projects you want updated in it.
# Automatic Compose discovery is used only for LXCs without manual entries.
#
# 105 /root
# 108 /opt/compose/plex
# 108 /opt/compose/home monitoring
#
# OPTIONAL COMPOSE SETTINGS
# Add a real Tab after the directory and between each key=value setting.
# Use no quotes around the values. Spaces within a value are allowed.
#   file=PATH          Compose file to pass to Docker Compose.
#   env-file=PATH      Environment file to pass to Docker Compose.
#   profile=NAME       Compose profile to enable.
#   project-name=NAME  Existing Compose project name to use.
# Relative file and env-file paths are resolved from the project directory.
# Repeat file= or profile= in another tab-separated field if needed.
# The example below already contains real tabs.
#
# 111 /opt/compose/media stack	file=compose.yml	env-file=.env.production	profile=workers	project-name=media
#
# In nano, press Ctrl+O then Enter to save, and Ctrl+X to exit.
# Run lxcdockercomposeupdater -plan to check exclusions and configured paths
# without starting any guests.
CONFIG
}

edit_config() {
    (( EUID == 0 )) || die 'Run -config as root to edit the default configuration.'
    local editor=${VISUAL:-${EDITOR:-}}
    if [[ -z $editor ]]; then
        if command -v nano >/dev/null; then
            editor=nano
        else
            editor=vi
        fi
    fi
    command -v "$editor" >/dev/null || die "Editor not found: $editor"
    if [[ ! -e $config ]]; then
        (umask 022; set -o noclobber; write_config_guide > "$config") ||
            die "Could not create $config."
    else
        grep -Fxq '# lxcdockercomposeupdater configuration guide' "$config"
        case $? in
            0) ;;
            1) { printf '\n'; write_config_guide; } >> "$config" ||
                die "Could not add the guide to $config." ;;
            *) die "Could not read $config." ;;
        esac
    fi
    exec "$editor" "$config"
}

usage() {
    cat <<'HELP'
Usage: lxcdockercomposeupdater [options] [LXC_ID ...]

  (no action)     Pull images and redeploy Compose projects.
  -prune          Remove dangling Docker images. Volumes are preserved.
  -plan           Show which guests would be visited without booting them.
  -config         Edit the default configuration file.
  -config FILE    Read an alternate configuration file.
  -getlatest      Update this command from GitHub without visiting guests.
  -help, -h       Show this help.

Supply LXC IDs to limit the run. By default, the command visits all local LXCs
except configured exclusions and templates. Double-dash options also work.
HELP
}

if [[ ${1:-} == -getlatest || ${1:-} == --getlatest ]]; then
    (( $# == 1 )) || die '-getlatest cannot be combined with other arguments.'
    get_latest
    exit $?
fi

if (( $# == 1 )) && [[ $1 == -config || $1 == --config ]]; then
    edit_config
fi

while (( $# )); do
    case $1 in
        -help|--help|-h) usage; exit 0 ;;
        -plan|--plan) plan=1; shift ;;
        -prune|--prune) prune=1; shift ;;
        -config|--config)
            (( $# >= 2 )) || die 'Missing configuration file path.'
            config=$2
            [[ -r $config ]] || die "Cannot read $config."
            shift 2 ;;
        --) shift; break ;;
        -*) die "Unknown option: $1" ;;
        *) break ;;
    esac
done

declare -a project_ids=() directories=() settings=() configured=() selected=() excluded=() summary=()
contains_id() {
    local needle=$1 candidate
    shift
    for candidate in "$@"; do
        [[ $candidate == "$needle" ]] && return 0
    done
    return 1
}

compose_options() {
    local fields=$1 setting key value
    options=()
    while [[ -n $fields ]]; do
        setting=${fields%%$'\t'*}
        if [[ $fields == *$'\t'* ]]; then
            fields=${fields#*$'\t'}
        else
            fields=
        fi
        key=${setting%%=*}
        value=${setting#*=}
        [[ $setting == *=* && -n $value ]] || return 1
        case $key in
            env-file|profile|project-name|file) options+=("--$key" "$value") ;;
            *) return 1 ;;
        esac
    done
}

if [[ -e $config ]]; then
    [[ -r $config ]] || die "Cannot read $config."
    line=0
    while read -r id directory || [[ -n $id ]]; do
        (( line += 1 ))
        [[ -z $id || $id == \#* ]] && continue
        if [[ $id == exclude ]]; then
            [[ $directory =~ ^[1-9][0-9]*$ ]] || die "$config:$line: expected exclude followed by an LXC ID."
            excluded+=("$directory")
            continue
        fi
        fields=
        if [[ $directory == *$'\t'* ]]; then
            fields=${directory#*$'\t'}
            directory=${directory%%$'\t'*}
        fi
        compose_options "$fields" || die "$config:$line: invalid Compose setting."
        [[ $id =~ ^[1-9][0-9]*$ && $directory == /* ]] ||
            die "$config:$line: expected an LXC ID followed by an absolute guest directory."
        project_ids+=("$id")
        directories+=("$directory")
        settings+=("$fields")
        if ! contains_id "$id" "${configured[@]}"; then
            configured+=("$id")
        fi
    done < "$config"
fi

(( EUID == 0 )) || die 'Run this as root on the Proxmox host.'
command -v pct >/dev/null || die 'Required command missing: pct'
if (( ! plan )); then
    for tool in flock timeout; do
        command -v "$tool" >/dev/null || die "Required command missing: $tool"
    done
    exec 9>>/run/lock/proxmox-lxc-updater.lock || die 'Could not open the updater lock.'
    flock -n 9 || die 'Could not acquire the updater lock. Another run may be active.'
fi

inventory=$(pct list) || die 'Could not list local LXCs.'
declare -a local_ids=()
while read -r id _; do
    [[ $id =~ ^[1-9][0-9]*$ ]] && local_ids+=("$id")
done <<< "$inventory"
explicit=$#
for id in "$@"; do
    contains_id "$id" "${local_ids[@]}" || die "LXC $id is not on this node."
    contains_id "$id" "${selected[@]}" || selected+=("$id")
done
if (( ${#selected[@]} == 0 )); then
    selected=("${local_ids[@]}")
fi
if (( ${#selected[@]} == 0 )); then
    printf 'No local LXCs found.\n'
    exit 0
fi

trap 'cancel=130' INT
trap 'cancel=143' TERM
trap 'cancel=129' HUP

wait_for_docker() {
    local id=$1 label=$2 deadline=$((SECONDS + 60)) remaining probe
    while (( cancel == 0 && SECONDS < deadline )); do
        remaining=$((deadline - SECONDS))
        (( remaining <= 5 )) || remaining=5
        if probe=$(timeout -k 1 "$remaining" pct exec "$id" -- sh -c '
            if command -v docker >/dev/null 2>&1; then
                docker info >/dev/null
            else
                printf "no-docker"
            fi' </dev/null 2>/dev/null); then
            [[ $probe != no-docker ]] || return 2
            return 0
        fi
        (( cancel == 0 && SECONDS < deadline )) && sleep 1
    done
    (( cancel == 0 )) || return 0
    printf '%s: Docker did not become ready within 60 seconds.\n' "$label" >&2
    return 1
}

run_compose() {
    local id=$1 label=$2 directory=$3 action=$4 result
    shift 4
    pct exec "$id" -- sh -c 'cd "$1" && shift && exec docker compose "$@"' \
        lxcdockercomposeupdater "$directory" "$@" </dev/null
    result=$?
    if (( result != 0 && cancel == 0 )); then
        printf '%s: docker compose %s failed in %s (exit %d). See command output above.\n' \
            "$label" "$action" "$directory" "$result" >&2
    fi
    return "$result"
}

update_project() {
    local id=$1 label=$2 directory=$3 before after container name container_state health
    local status_format='{{.ID}}{{printf "\x1f"}}{{.Name}}{{printf "\x1f"}}{{.State}}{{printf "\x1f"}}{{.Health}}'
    shift 3
    printf '%s pulling Compose images in %s\n' "$label" "$directory"
    run_compose "$id" "$label" "$directory" pull "$@" pull || return 1
    (( cancel == 0 )) || return 0
    before=$(run_compose "$id" "$label" "$directory" 'ps --status running' \
        "$@" ps --orphans=false --status running --format '{{.ID}}') || return 1
    (( cancel == 0 )) || return 0
    printf '%s starting the Compose project in %s\n' "$label" "$directory"
    printf '  docker compose'
    printf ' %q' "$@" up -d
    printf '\n'
    run_compose "$id" "$label" "$directory" 'up -d' "$@" up -d || return 1
    (( cancel == 0 )) || return 0
    printf '%s: docker compose up -d succeeded. Container status before power-state cleanup:\n' "$label"
    after=$(run_compose "$id" "$label" "$directory" 'ps --all' \
        "$@" ps --all --orphans=false --format "$status_format") || return 1
    if [[ -z $after ]]; then
        printf '  No containers found.\n'
        compose_attention=1
        return 0
    fi
    while IFS=$'\x1f' read -r container name container_state health; do
        printf '  %s: %s%s\n' "$name" "$container_state" "${health:+ ($health)}"
        if [[ $container_state != running || $health == unhealthy || $health == starting ]]; then
            compose_attention=1
        fi
        if [[ $container_state == running && $'\n'$before$'\n' != *$'\n'"$container"$'\n'* ]]; then
            compose_changed=1
        fi
    done <<< "$after"
    return 0
}

count_prune_candidates() {
    local id=$1 images used image
    local -a candidates=()
    images=$(pct exec "$id" -- docker image ls --filter dangling=true --quiet --no-trunc </dev/null) ||
        return 1
    if [[ -z $images ]]; then
        printf '0\n'
        return 0
    fi
    used=$(pct exec "$id" -- sh -c '
        containers=$(docker container ls --all --quiet) || exit 1
        [ -n "$containers" ] || exit 0
        set -f
        set -- $containers
        exec docker container inspect --format "{{.Image}}" "$@"
    ' </dev/null) || return 1
    while IFS= read -r image; do
        [[ -n $image ]] || continue
        [[ $'\n'$used$'\n' != *$'\n'"$image"$'\n'* ]] || continue
        contains_id "$image" "${candidates[@]}" || candidates+=("$image")
    done <<< "$images"
    printf '%d\n' "${#candidates[@]}"
}

update_projects() {
    local id=$1 label=$2 index readiness records project directory files file
    local -a handled=() compose_args=() compose_files=() options=()
    wait_for_docker "$id" "$label"
    readiness=$?
    (( readiness != 2 )) || return 2
    (( readiness == 0 )) || return 1
    (( cancel == 0 )) || return 0
    docker_ready=1

    if (( prune )); then
        printf '%s pruning dangling Docker images\n' "$label"
        pct exec "$id" -- docker image prune --force </dev/null || return 1
        return 0
    fi
    if ! pct exec "$id" -- docker compose version </dev/null >/dev/null 2>&1; then
        return 4
    fi
    if contains_id "$id" "${configured[@]}"; then
        for index in "${!project_ids[@]}"; do
            (( cancel == 0 )) || break
            [[ ${project_ids[index]} == "$id" ]] || continue
            compose_options "${settings[index]}"
            update_project "$id" "$label" "${directories[index]}" "${options[@]}" || return 1
        done
        return 0
    fi

    records=$(pct exec "$id" -- docker ps -a \
        --filter label=com.docker.compose.project \
        --format '{{.Label "com.docker.compose.project"}}{{printf "\x1f"}}{{.Label "com.docker.compose.project.working_dir"}}{{printf "\x1f"}}{{.Label "com.docker.compose.project.config_files"}}' </dev/null) ||
        return 1
    if [[ -z $records ]]; then
        return 3
    fi
    while IFS=$'\x1f' read -r project directory files; do
        (( cancel == 0 )) || break
        contains_id "$project" "${handled[@]}" && continue
        if [[ -z $project || $directory != /* || -z $files ]]; then
            printf '%s: incomplete Compose labels for project %s. Set its guest directory in the config.\n' "$label" "$project" >&2
            return 1
        fi
        handled+=("$project")
        compose_args=(-p "$project")
        IFS=, read -r -a compose_files <<< "$files"
        for file in "${compose_files[@]}"; do
            compose_args+=(-f "$file")
        done
        update_project "$id" "$label" "$directory" "${compose_args[@]}" || return 1
    done <<< "$records"
    return 0
}

failed=0
for id in "${selected[@]}"; do
    (( cancel == 0 )) || break
    label="LXC $id"
    guest_config=$(pct config "$id")
    config_status=$?
    if [[ $guest_config =~ (^|$'\n')hostname:[[:blank:]]+([^[:space:]]+) ]]; then
        label="${BASH_REMATCH[2]} ($label)"
    fi
    if (( explicit == 0 )) && contains_id "$id" "${excluded[@]}"; then
        summary+=("$label: skipped (excluded)")
        continue
    fi
    if (( config_status != 0 )); then
        summary+=("$label: failed to read guest configuration")
        failed=1
        continue
    fi
    if [[ $guest_config =~ (^|$'\n')template:[[:blank:]]+1($|$'\n') ]]; then
        summary+=("$label: skipped (template)")
        continue
    fi
    if ! state=$(pct status "$id"); then
        summary+=("$label: failed to read power state")
        failed=1
        continue
    fi
    case "$state" in
        'status: running'|'status: stopped') ;;
        *)
            summary+=("$label: unexpected power state ($state)")
            failed=1
            continue ;;
    esac
    (( cancel == 0 )) || break
    if (( plan )); then
        action='check for Compose projects'
        (( ! prune )) || action='prune dangling Docker images if Docker is available'
        if [[ $state == 'status: stopped' ]]; then
            summary+=("$label: would start, $action, then shut down")
        else
            summary+=("$label: would $action and leave running")
        fi
        for index in "${!project_ids[@]}"; do
            (( ! prune )) && [[ ${project_ids[index]} == "$id" ]] && summary+=("  Configured: ${directories[index]}")
        done
        continue
    fi
    printf '%s was %s\n' "$label" "${state#status: }"
    if [[ $state == 'status: stopped' ]]; then
        printf '%s starting for maintenance\n' "$label"
        if ! pct start "$id"; then
            summary+=("$label: LXC start failed")
            failed=1
            continue
        fi
    fi

    outcome=interrupted
    compose_changed=0
    compose_attention=0
    docker_ready=0
    prune_note=
    if (( cancel == 0 )); then
        update_projects "$id" "$label"
        result=$?
        case $result in
            0)
                if (( prune )); then
                    outcome='prune completed'
                elif (( compose_attention )); then
                    outcome='Compose applied; check container status'
                elif (( compose_changed )); then
                    outcome='updated and running'
                else
                    outcome='containers verified running; none started or recreated by Compose'
                fi ;;
            2)
                if (( prune )); then
                    outcome='skipped (Docker not installed)'
                else
                    outcome='skipped (Docker Compose not installed; Docker CLI missing)'
                fi ;;
            3) outcome='skipped (no deployed Compose projects)' ;;
            4) outcome='skipped (Docker Compose not installed or unavailable)' ;;
            *) if (( prune )); then outcome='prune failed'; else outcome='update failed'; fi; failed=1 ;;
        esac
        if (( cancel != 0 )); then
            outcome=interrupted
        elif (( result >= 2 && result <= 4 )); then
            printf '%s: %s\n' "$label" "$outcome"
        fi
    fi
    if (( docker_ready && ! prune && cancel == 0 )); then
        if prune_count=$(count_prune_candidates "$id"); then
            case $prune_count in
                0) prune_note=' | Prune: 0 candidates' ;;
                1) prune_note=' | Prune: 1 candidate (consider pruning)' ;;
                *) prune_note=" | Prune: $prune_count candidates (consider pruning)" ;;
            esac
        else
            prune_note=' | Prune: count unavailable'
        fi
    fi
    power='already running, left on'
    if [[ $state == 'status: stopped' ]]; then
        power='started for maintenance, restored to stopped'
        if [[ $(pct status "$id") != 'status: stopped' ]]; then
            printf '%s shutting down\n' "$label"
            if ! pct shutdown "$id" --timeout 60 || [[ $(pct status "$id") != 'status: stopped' ]]; then
                power='shutdown failed; check power state'
                failed=1
            fi
        fi
    fi
    summary+=("$label: $outcome | LXC: $power$prune_note")
done
if (( plan )); then
    printf '\nPlan (no guests started or changed)\n'
else
    printf '\nRun summary\n'
fi
if (( ${#summary[@]} )); then
    printf '%s\n' "${summary[@]}"
fi
(( cancel == 0 )) || exit "$cancel"
exit "$failed"
